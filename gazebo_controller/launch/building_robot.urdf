<?xml version="1.0"?>
<robot name="vehicle_blue">
  <material name="red">
    <color rgba="0.8 0 0 1"/>
  </material>
 
  <material name="green">
    <color rgba="0 0.8 0 1"/>
  </material>  

  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <link name="base_link"/>

  <joint name="base_link_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin rpy="0 0 0" xyz="0.5 0 0.4"/>
  </joint>

  <link name="chassis">
    <visual>
      <geometry>
        <box size="2.0 1.0 0.5"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.4"/>
      </geometry>
      <material name="red"/>      
    </visual>
  </link>

  <joint name="chassis_to_left_wheel" type="fixed">
    <parent link="chassis"/>
    <child link="left_wheel"/>
    <origin rpy="1.57075 0 0" xyz="-0.5 0.6 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.4"/>
      </geometry>
      <material name="red"/>  
    </visual>
  </link>

  <joint name="chassis_to_right_wheel" type="fixed">
    <parent link="chassis"/>
    <child link="right_wheel"/>
    <origin rpy="1.57075 0 0" xyz="-0.5 -0.6 0"/>
  </joint>

  <link name="caster">
    <visual>
      <geometry>
        <sphere radius="0.2"/>
      </geometry>
      <material name="green"/> 
    </visual>
  </link>

  <joint name="chassis_to_caster" type="fixed">
    <parent link="chassis"/>
    <child link="caster"/>
    <origin rpy="0 0 0" xyz="0.8 0 -0.2"/>
  </joint>

</robot>